<?xml version="1.0" encoding="utf-8"?>
<!-- PROFILE BUILDS ONLY (integrator emulator verification, never distributed): plain HTTP to the
     emulator alias of the dev machine. Only 10.0.2.2 and localhost are allowed here;
     scripts/check-cleartext.sh fails on any other domain. Release: HTTPS only. -->
