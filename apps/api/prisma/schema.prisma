// Saarthee data model (04-database-design.md §3). Hand-written SQL (CHECKs, partial indexes,
// events identity, views) lives in the migrations because Prisma cannot express it.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum SourceTag {
  rwa
  activist
  social
  network
  unknown

  @@map("source_tag")
}

enum VerificationResult {
  fixed
  not_fixed

  @@map("verification_result")
}

enum PhotoPurpose {
  report
  verification

  @@map("photo_purpose")
}

enum StorageDriver {
  local
  cloudflare_r2

  @@map("storage_driver")
}

enum ReminderChannel {
  whatsapp_manual

  @@map("reminder_channel")
}

enum ExclusionReason {
  test
  invalid
  duplicate
  other

  @@map("exclusion_reason")
}

enum Platform {
  android
  ios

  @@map("platform")
}

model AdminUser {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  displayName  String    @map("display_name") @db.VarChar(100)
  isActive     Boolean   @default(true) @map("is_active")
  tokenVersion Int       @default(0) @map("token_version")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  inviteCodes        InviteCode[]
  excludedComplaints Complaint[]
  reminders          Reminder[]
  events             Event[]

  @@unique([email], map: "uq_admin_users_email")
  @@map("admin_users")
}

model InviteCode {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String    @db.VarChar(20)
  sourceTag  SourceTag @map("source_tag")
  groupLabel String    @map("group_label") @db.VarChar(120)
  wardHint   String?   @map("ward_hint") @db.VarChar(50)
  isActive   Boolean   @default(true) @map("is_active")
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator    AdminUser?  @relation(fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: Cascade)
  complaints Complaint[]

  @@unique([code], map: "uq_invite_codes_code")
  @@index([sourceTag], map: "idx_invite_codes_source_tag")
  @@index([createdBy], map: "idx_invite_codes_created_by")
  @@map("invite_codes")
}

model CcrsCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(100)
  ccrsLabel String?  @map("ccrs_label") @db.VarChar(150)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  complaints Complaint[]

  @@unique([name], map: "uq_ccrs_categories_name")
  @@index([isActive, sortOrder], map: "idx_ccrs_categories_active_order")
  @@map("ccrs_categories")
}

model Photo {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storageDriver          StorageDriver @default(local) @map("storage_driver")
  storageKey             String        @map("storage_key") @db.VarChar(255)
  purpose                PhotoPurpose
  mimeType               String        @map("mime_type") @db.VarChar(50)
  byteSize               Int           @map("byte_size")
  widthPx                Int?          @map("width_px")
  heightPx               Int?          @map("height_px")
  sha256                 String        @db.Char(64)
  uploadedForComplaintId String?       @map("uploaded_for_complaint_id") @db.Uuid
  uploadedAt             DateTime      @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  attachedAt             DateTime?     @map("attached_at") @db.Timestamptz(6)
  deletedAt              DateTime?     @map("deleted_at") @db.Timestamptz(6)

  uploadedForComplaint Complaint?    @relation("PhotoUploadedFor", fields: [uploadedForComplaintId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  complaint            Complaint?    @relation("ComplaintPhoto")
  verification         Verification?

  // v2 (TASK-01): photos are reused by issues.
  issuePhoto         IssuePhoto?
  issueEvents        IssueEvent[]
  issueVerifications IssueVerification[]

  // v2 (TASK-05): citizen uploads are owned; blurApplied is reported by the app (on-device blur).
  uploadedByUserId String? @map("uploaded_by_user_id") @db.Uuid
  blurApplied      Boolean @default(false) @map("blur_applied")
  uploadedByUser   User?   @relation("PhotoUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_photos_uploaded_by_user")

  @@unique([storageKey], map: "uq_photos_storage_key")
  @@index([uploadedByUserId, uploadedAt], map: "idx_photos_uploader_uploaded")
  @@index([sha256], map: "idx_photos_sha256")
  @@index([uploadedForComplaintId], map: "idx_photos_uploaded_for_complaint")
  @@map("photos")
}

model Complaint {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientSubmissionId   String           @map("client_submission_id") @db.Uuid
  inviteCodeId         String?          @map("invite_code_id") @db.Uuid
  sourceTag            SourceTag        @default(unknown) @map("source_tag")
  categoryId           String           @map("category_id") @db.Uuid
  ccrsNumberRaw        String           @map("ccrs_number_raw") @db.VarChar(50)
  ccrsNumberNormalized String           @map("ccrs_number_normalized") @db.VarChar(50)
  ccrsDuplicateFlag    Boolean          @default(false) @map("ccrs_duplicate_flag")
  photoId              String           @map("photo_id") @db.Uuid
  latitude             Decimal          @db.Decimal(9, 6)
  longitude            Decimal          @db.Decimal(9, 6)
  gpsAccuracyM         Decimal?         @map("gps_accuracy_m") @db.Decimal(8, 2)
  deviceCapturedAt     DateTime         @map("device_captured_at") @db.Timestamptz(6)
  phoneE164            String?          @map("phone_e164") @db.VarChar(16)
  consentGivenAt       DateTime         @map("consent_given_at") @db.Timestamptz(6)
  consentTextVersion   String           @map("consent_text_version") @db.VarChar(20)
  appPlatform          Platform         @map("app_platform")
  appVersion           String           @map("app_version") @db.VarChar(20)
  wardCode             String?          @map("ward_code") @db.VarChar(50)
  isExcluded           Boolean          @default(false) @map("is_excluded")
  exclusionReason      ExclusionReason? @map("exclusion_reason")
  exclusionNote        String?          @map("exclusion_note") @db.VarChar(500)
  excludedBy           String?          @map("excluded_by") @db.Uuid
  excludedAt           DateTime?        @map("excluded_at") @db.Timestamptz(6)
  anonymizedAt         DateTime?        @map("anonymized_at") @db.Timestamptz(6)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  inviteCode     InviteCode?    @relation(fields: [inviteCodeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category       CcrsCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  photo          Photo          @relation("ComplaintPhoto", fields: [photoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  excluder       AdminUser?     @relation(fields: [excludedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)
  uploadedPhotos Photo[]        @relation("PhotoUploadedFor")
  reminders      Reminder[]
  verifications  Verification[]
  events         Event[]
  /// v2 (TASK-01): the issue this complaint was copied into by legacy:migrate.
  issue          Issue?

  @@unique([clientSubmissionId], map: "uq_complaints_client_submission")
  @@unique([photoId], map: "uq_complaints_photo")
  @@index([ccrsNumberNormalized], map: "idx_complaints_ccrs_norm")
  @@index([sourceTag, createdAt], map: "idx_complaints_source_created")
  @@index([categoryId], map: "idx_complaints_category")
  @@index([phoneE164], map: "idx_complaints_phone")
  @@index([inviteCodeId], map: "idx_complaints_invite_code")
  @@map("complaints")
}

model Reminder {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  complaintId String          @map("complaint_id") @db.Uuid
  tokenHash   String          @map("token_hash") @db.Char(64)
  channel     ReminderChannel @default(whatsapp_manual)
  sentBy      String          @map("sent_by") @db.Uuid
  sentAt      DateTime        @default(now()) @map("sent_at") @db.Timestamptz(6)
  expiresAt   DateTime?       @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime?       @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  complaint     Complaint      @relation(fields: [complaintId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sender        AdminUser      @relation(fields: [sentBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
  verifications Verification[]

  @@unique([tokenHash], map: "uq_reminders_token_hash")
  @@index([complaintId, sentAt(sort: Desc)], map: "idx_reminders_complaint_sent")
  @@index([sentBy], map: "idx_reminders_sent_by")
  @@map("reminders")
}

model Verification {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientSubmissionId  String             @map("client_submission_id") @db.Uuid
  complaintId         String             @map("complaint_id") @db.Uuid
  reminderId          String?            @map("reminder_id") @db.Uuid
  result              VerificationResult
  photoId             String             @map("photo_id") @db.Uuid
  latitude            Decimal            @db.Decimal(9, 6)
  longitude           Decimal            @db.Decimal(9, 6)
  gpsAccuracyM        Decimal?           @map("gps_accuracy_m") @db.Decimal(8, 2)
  deviceCapturedAt    DateTime           @map("device_captured_at") @db.Timestamptz(6)
  distanceFromReportM Decimal?           @map("distance_from_report_m") @db.Decimal(10, 2)
  note                String?            @db.VarChar(1000)
  appPlatform         Platform           @map("app_platform")
  appVersion          String             @map("app_version") @db.VarChar(20)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reminder  Reminder? @relation(fields: [reminderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  photo     Photo     @relation(fields: [photoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([clientSubmissionId], map: "uq_verifications_client_submission")
  @@unique([photoId], map: "uq_verifications_photo")
  @@index([complaintId, createdAt(sort: Desc)], map: "idx_verifications_complaint_created")
  @@index([reminderId], map: "idx_verifications_reminder")
  @@map("verifications")
}

model Event {
  id          BigInt     @id @default(autoincrement())
  name        String     @db.VarChar(50)
  installId   String?    @map("install_id") @db.Uuid
  adminUserId String?    @map("admin_user_id") @db.Uuid
  complaintId String?    @map("complaint_id") @db.Uuid
  sourceTag   SourceTag? @map("source_tag")
  properties  Json       @default("{}")
  platform    Platform?
  appVersion  String?    @map("app_version") @db.VarChar(20)
  occurredAt  DateTime   @map("occurred_at") @db.Timestamptz(6)
  receivedAt  DateTime   @default(now()) @map("received_at") @db.Timestamptz(6)

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  complaint Complaint? @relation(fields: [complaintId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([name, receivedAt], map: "idx_events_name_received")
  @@index([complaintId], map: "idx_events_complaint")
  @@index([installId], map: "idx_events_install")
  @@map("events")
}

// ---------------------------------------------------------------------------------------------------
// v2 (V2 TASK-01 §5.2, Spec §6). Hand-written SQL in the migrations: CHECKs, partial indexes
// (idx_users_role, uq_consents_active, idx_issues_sla_open), the issues location trigger, the
// issue_events append-only trigger and the legacy read-only triggers on v1 tables.
// Later tasks append their models at the end of this file.
// ---------------------------------------------------------------------------------------------------

enum UserRole {
  citizen
  moderator
  admin
  representative

  @@map("user_role")
}

enum UserStatus {
  active
  suspended
  deleted

  @@map("user_status")
}

enum AppLanguage {
  gu
  en

  @@map("app_language")
}

enum ConsentPurpose {
  core_service
  share_with_representatives
  share_with_amc_handoff
  notifications

  @@map("consent_purpose")
}

enum IssueStatus {
  reported
  sent
  acknowledged
  in_progress
  marked_fixed
  verified
  reopened
  rejected
  merged

  @@map("issue_status")
}

enum IssueVisibility {
  public
  hidden

  @@map("issue_visibility")
}

enum IssuePhotoKind {
  report
  after
  verification

  @@map("issue_photo_kind")
}

enum IssueEventType {
  status_change
  comment
  ccrs_linked
  escalated
  merged
  rejected

  @@map("issue_event_type")
}

enum ActorRole {
  citizen
  moderator
  admin
  representative
  system

  @@map("actor_role")
}

model User {
  id             String      @id(map: "pk_users") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneE164      String?     @map("phone_e164") @db.VarChar(16)
  firebaseUid    String?     @map("firebase_uid") @db.VarChar(128)
  displayName    String?     @map("display_name") @db.VarChar(60)
  /// FK to wards added by TASK-02.
  homeWardId     String?     @map("home_ward_id") @db.Uuid
  language       AppLanguage @default(gu)
  role           UserRole    @default(citizen)
  status         UserStatus  @default(active)
  tokenVersion   Int         @default(0) @map("token_version")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt     DateTime?   @map("last_seen_at") @db.Timestamptz(6)
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(6)
  /// TASK-04: self-declared 18+ confirmation (no birth date stored).
  ageConfirmedAt DateTime?   @map("age_confirmed_at") @db.Timestamptz(6)

  consents           Consent[]
  notifications      Notification[]
  devices            Device[]
  reportedIssues     Issue[]
  issueEvents        IssueEvent[]
  issueVerifications IssueVerification[]
  meToos             MeToo[]
  follows            Follow[]
  uploadedPhotos     Photo[]             @relation("PhotoUploadedBy")
  homeWard           Ward?               @relation(fields: [homeWardId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_users_home_ward")

  @@unique([phoneE164], map: "uq_users_phone")
  @@unique([firebaseUid], map: "uq_users_firebase_uid")
  @@index([homeWardId], map: "idx_users_home_ward")
  @@map("users")
}

model Consent {
  id          String         @id(map: "pk_consents") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  purpose     ConsentPurpose
  textVersion String         @map("text_version") @db.VarChar(20)
  grantedAt   DateTime       @default(now()) @map("granted_at") @db.Timestamptz(6)
  withdrawnAt DateTime?      @map("withdrawn_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_consents_user")

  @@index([userId], map: "idx_consents_user")
  @@index([userId, purpose], map: "idx_consents_user_purpose")
  @@map("consents")
}

model Device {
  id         String      @id(map: "pk_devices") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?     @map("user_id") @db.Uuid
  installId  String      @map("install_id") @db.Uuid
  fcmToken   String?     @map("fcm_token") @db.VarChar(4096)
  platform   Platform
  appVersion String      @map("app_version") @db.VarChar(20)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime    @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  /// TASK-04: push language (topic suffix) and the topics last reported by the app (diagnostic only).
  language   AppLanguage @default(gu)
  topics     String[]    @default([])

  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_devices_user")
  notifications Notification[]

  @@unique([installId], map: "uq_devices_install")
  @@unique([fcmToken], map: "uq_devices_fcm_token")
  @@index([userId], map: "idx_devices_user")
  @@map("devices")
}

model Category {
  id          String   @id(map: "pk_categories") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @db.VarChar(32)
  nameEn      String   @map("name_en") @db.VarChar(60)
  nameGu      String   @map("name_gu") @db.VarChar(60)
  icon        String   @db.VarChar(64)
  colourToken String   @map("colour_token") @db.VarChar(40)
  slaDays     Int      @map("sla_days") @db.SmallInt
  sensitive   Boolean  @default(false)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  issues          Issue[]
  amcProblemTypes AmcProblemType[]

  @@unique([slug], map: "uq_categories_slug")
  @@index([isActive, sortOrder], map: "idx_categories_active_order")
  @@map("categories")
}

model Issue {
  id                 String                                 @id(map: "pk_issues") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientSubmissionId String                                 @map("client_submission_id") @db.Uuid
  reporterId         String?                                @map("reporter_id") @db.Uuid
  categoryId         String                                 @map("category_id") @db.Uuid
  title              String                                 @db.VarChar(120)
  description        String?                                @db.VarChar(1000)
  lat                Decimal                                @db.Decimal(9, 6)
  lng                Decimal                                @db.Decimal(9, 6)
  /// Filled from lat/lng by trigger trg_issues_location; read it only through $queryRaw (src/lib/geo).
  location           Unsupported("geography(Point, 4326)")?
  gpsAccuracyM       Decimal?                               @map("gps_accuracy_m") @db.Decimal(8, 2)
  /// FK to wards added by TASK-02.
  wardId             String?                                @map("ward_id") @db.Uuid
  /// FK to zones added by TASK-02.
  zoneId             String?                                @map("zone_id") @db.Uuid
  addressText        String?                                @map("address_text") @db.VarChar(200)
  status             IssueStatus                            @default(reported)
  statusChangedAt    DateTime                               @default(now()) @map("status_changed_at") @db.Timestamptz(6)
  slaDueAt           DateTime                               @map("sla_due_at") @db.Timestamptz(6)
  meTooCount         Int                                    @default(0) @map("me_too_count")
  followerCount      Int                                    @default(0) @map("follower_count")
  ccrsNumber         String?                                @map("ccrs_number") @db.VarChar(50)
  ccrsFiledAt        DateTime?                              @map("ccrs_filed_at") @db.Timestamptz(6)
  visibility         IssueVisibility                        @default(public)
  isSensitive        Boolean                                @default(false) @map("is_sensitive")
  mergedIntoId       String?                                @map("merged_into_id") @db.Uuid
  legacyComplaintId  String?                                @map("legacy_complaint_id") @db.Uuid
  createdAt          DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  reporter        User?      @relation(fields: [reporterId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_issues_reporter")
  category        Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_issues_category")
  mergedInto      Issue?     @relation("IssueMerges", fields: [mergedIntoId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_issues_merged_into")
  mergedIssues    Issue[]    @relation("IssueMerges")
  legacyComplaint Complaint? @relation(fields: [legacyComplaintId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_issues_legacy_complaint")
  ward            Ward?      @relation(fields: [wardId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_issues_ward")
  zone            Zone?      @relation(fields: [zoneId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_issues_zone")

  photos        IssuePhoto[]
  events        IssueEvent[]
  verifications IssueVerification[]
  meToos        MeToo[]
  follows       Follow[]

  @@unique([clientSubmissionId], map: "uq_issues_client_submission")
  @@unique([legacyComplaintId], map: "uq_issues_legacy_complaint")
  @@index([location], map: "idx_issues_location", type: Gist)
  @@index([status, statusChangedAt(sort: Desc)], map: "idx_issues_status")
  @@index([wardId, status], map: "idx_issues_ward_status")
  @@index([zoneId], map: "idx_issues_zone")
  @@index([categoryId, createdAt(sort: Desc)], map: "idx_issues_category_created")
  @@index([reporterId], map: "idx_issues_reporter")
  @@index([reporterId, createdAt(sort: Desc)], map: "idx_issues_reporter_created")
  @@index([mergedIntoId], map: "idx_issues_merged_into")
  @@map("issues")
}

model IssuePhoto {
  issueId  String         @map("issue_id") @db.Uuid
  photoId  String         @map("photo_id") @db.Uuid
  kind     IssuePhotoKind
  position Int            @default(0) @db.SmallInt

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_issue_photos_issue")
  photo Photo @relation(fields: [photoId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_issue_photos_photo")

  @@id([issueId, photoId], map: "pk_issue_photos")
  @@unique([photoId], map: "uq_issue_photos_photo")
  @@unique([issueId, kind, position], map: "uq_issue_photos_position")
  @@map("issue_photos")
}

/// Append-only (trigger trg_issue_events_append_only).
model IssueEvent {
  id         String         @id(map: "pk_issue_events") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issueId    String         @map("issue_id") @db.Uuid
  actorId    String?        @map("actor_id") @db.Uuid
  actorRole  ActorRole      @map("actor_role")
  type       IssueEventType
  fromStatus IssueStatus?   @map("from_status")
  toStatus   IssueStatus?   @map("to_status")
  note       String?        @db.VarChar(500)
  photoId    String?        @map("photo_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  issue Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_issue_events_issue")
  actor User?  @relation(fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_issue_events_actor")
  photo Photo? @relation(fields: [photoId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_issue_events_photo")

  @@index([issueId, createdAt], map: "idx_issue_events_issue_created")
  @@index([actorId], map: "idx_issue_events_actor")
  @@map("issue_events")
}

model IssueVerification {
  id         String             @id(map: "pk_issue_verifications") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issueId    String             @map("issue_id") @db.Uuid
  userId     String             @map("user_id") @db.Uuid
  answer     VerificationResult
  photoId    String?            @map("photo_id") @db.Uuid
  lat        Decimal?           @db.Decimal(9, 6)
  lng        Decimal?           @db.Decimal(9, 6)
  distanceM  Decimal?           @map("distance_m") @db.Decimal(8, 1)
  /// Asia/Kolkata calendar day, set by the service (one verification per user, issue and day).
  createdDay DateTime           @map("created_day") @db.Date
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  issue Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_issue_verifications_issue")
  user  User   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_issue_verifications_user")
  photo Photo? @relation(fields: [photoId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_issue_verifications_photo")

  @@unique([issueId, userId, createdDay], map: "uq_issue_verifications_daily")
  @@index([userId], map: "idx_issue_verifications_user")
  @@map("issue_verifications")
}

model MeToo {
  issueId   String   @map("issue_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_me_toos_issue")
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_me_toos_user")

  @@id([issueId, userId], map: "pk_me_toos")
  @@index([userId, createdAt(sort: Desc)], map: "idx_me_toos_user_created")
  @@map("me_toos")
}

model Follow {
  issueId   String   @map("issue_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_follows_issue")
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_follows_user")

  @@id([issueId, userId], map: "pk_follows")
  @@index([userId, createdAt(sort: Desc)], map: "idx_follows_user_created")
  @@map("follows")
}

// V2 TASK-02: AMC zones and wards. Geometry columns are read/written only through $queryRaw (src/modules/geo,
// src/lib/geo/import). CHECKs (ck_zones_code, ck_wards_number, ck_wards_geom_valid, ck_wards_phone,
// ck_wards_population) are hand-written in migration 20261005000000_create_zones_wards.
model Zone {
  id        String                                       @id(map: "pk_zones") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String                                       @db.VarChar(20)
  nameEn    String                                       @map("name_en") @db.VarChar(60)
  nameGu    String                                       @map("name_gu") @db.VarChar(60)
  sortOrder Int                                          @default(0) @map("sort_order") @db.SmallInt
  geom      Unsupported("geometry(MultiPolygon, 4326)")?
  createdAt DateTime                                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime                                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  wards  Ward[]
  issues Issue[]

  @@unique([code], map: "uq_zones_code")
  @@index([geom], map: "idx_zones_geom", type: Gist)
  @@map("zones")
}

model Ward {
  id              String                                      @id(map: "pk_wards") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number          Int                                         @db.SmallInt
  nameEn          String                                      @map("name_en") @db.VarChar(60)
  nameGu          String                                      @map("name_gu") @db.VarChar(60)
  zoneId          String                                      @map("zone_id") @db.Uuid
  geom            Unsupported("geometry(MultiPolygon, 4326)")
  centroid        Unsupported("geometry(Point, 4326)")
  boundaryVersion String                                      @map("boundary_version") @db.VarChar(60)
  officeAddressEn String?                                     @map("office_address_en") @db.VarChar(300)
  officeAddressGu String?                                     @map("office_address_gu") @db.VarChar(300)
  officePhone     String?                                     @map("office_phone") @db.VarChar(20)
  population      Int?
  sourceUrl       String                                      @map("source_url") @db.VarChar(500)
  lastVerifiedAt  DateTime                                    @map("last_verified_at") @db.Timestamptz(6)
  createdAt       DateTime                                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  zone      Zone    @relation(fields: [zoneId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_wards_zone")
  issues    Issue[]
  homeUsers User[]

  @@unique([number], map: "uq_wards_number")
  @@index([zoneId], map: "idx_wards_zone")
  @@index([geom], map: "idx_wards_geom", type: Gist)
  @@map("wards")
}

/// TASK-04: push delivery log (REQ-F-011). kind/status/channel/topic CHECKs and the partial queue index
/// idx_notifications_queued are hand-written in the migration. TASK-08 extends this table.
model Notification {
  id                 String    @id(map: "pk_notifications") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String?   @map("user_id") @db.Uuid
  deviceId           String?   @map("device_id") @db.Uuid
  topic              String?   @db.VarChar(60)
  kind               String
  refId              String?   @map("ref_id")
  route              String?
  channel            String    @default("updates") @db.VarChar(20)
  titleEn            String    @map("title_en") @db.VarChar(120)
  titleGu            String    @map("title_gu") @db.VarChar(120)
  bodyEn             String    @map("body_en") @db.VarChar(400)
  bodyGu             String    @map("body_gu") @db.VarChar(400)
  status             String
  sendAfter          DateTime? @map("send_after") @db.Timestamptz(6)
  sentAt             DateTime? @map("sent_at") @db.Timestamptz(6)
  providerMessageIds String[]  @default([]) @map("provider_message_ids")
  errorCode          String?   @map("error_code")
  readAt             DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_notifications_user")
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_notifications_device")

  @@index([userId, createdAt(sort: Desc)], map: "idx_notifications_user_created")
  @@index([kind, refId], map: "idx_notifications_kind_ref")
  @@map("notifications")
}

// V2 TASK-05: AMC CCRS problem types (snapshot of the public CCRS list, refreshed only by
// `npm run amc:problems:fetch`). Partial unique index uq_amc_problem_types_primary (one primary per
// category) is hand-written in migration 20261006050500_v2_reporting_amc_problem_types.
model AmcProblemType {
  id                String   @id(map: "pk_amc_problem_types") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId        String   @map("category_id") @db.Uuid
  /// sha1(department|problemCategory|problem) — the CCRS JSON has no stable id.
  sourceKey         String   @map("source_key") @db.Char(40)
  ccrsRow           Int?     @map("ccrs_row")
  deptEn            String   @map("dept_en") @db.VarChar(80)
  deptGu            String   @map("dept_gu") @db.VarChar(120)
  problemCategoryEn String   @map("problem_category_en") @db.VarChar(160)
  problemEn         String   @map("problem_en") @db.VarChar(300)
  problemGu         String   @map("problem_gu") @db.VarChar(300)
  isPrimary         Boolean  @default(false) @map("is_primary")
  isActive          Boolean  @default(true) @map("is_active")
  fetchedAt         DateTime @map("fetched_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_amc_problem_types_category")

  @@unique([sourceKey], map: "uq_amc_problem_types_source_key")
  @@index([categoryId, isActive], map: "idx_amc_problem_types_category")
  @@map("amc_problem_types")
}
