model Alert {
  id               String                                       @id(map: "pk_alerts") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type             AlertType
  severity         AlertSeverity
  titleEn          String                                       @default("") @map("title_en")
  titleGu          String                                       @default("") @map("title_gu")
  bodyEn           String                                       @default("") @map("body_en")
  bodyGu           String                                       @default("") @map("body_gu")
  sourceName       String                                       @map("source_name")
  sourceUrl        String                                       @map("source_url")
  validFrom        DateTime                                     @map("valid_from") @db.Timestamptz(6)
  validTo          DateTime                                     @map("valid_to") @db.Timestamptz(6)
  targetScope      AlertScope                                   @map("target_scope")
  targetZoneId     String?                                      @map("target_zone_id") @db.Uuid
  area             Unsupported("geometry(MultiPolygon, 4326)")?
  status           AlertStatus                                  @default(draft)
  origin           AlertOrigin                                  @default(manual)
  originRef        String?                                      @map("origin_ref")
  /// Staff actor ids (v2 users or v1 admin_users) — no FK by design (TASK-08 §5.6).
  createdBy        String?                                      @map("created_by") @db.Uuid
  approvedBy       String[]                                     @default([]) @map("approved_by") @db.Uuid
  submittedAt      DateTime?                                    @map("submitted_at") @db.Timestamptz(6)
  publishedAt      DateTime?                                    @map("published_at") @db.Timestamptz(6)
