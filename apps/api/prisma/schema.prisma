  pushedAt         DateTime?                                    @map("pushed_at") @db.Timestamptz(6)
  supersedesId     String?                                      @unique(map: "uq_alerts_supersedes") @map("supersedes_id") @db.Uuid
  retractedAt      DateTime?                                    @map("retracted_at") @db.Timestamptz(6)
  retractedBy      String?                                      @map("retracted_by") @db.Uuid
  retractionReason String?                                      @map("retraction_reason")
  createdAt        DateTime                                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  targetZone   Zone?       @relation(fields: [targetZoneId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_alerts_zone")
  supersedes   Alert?      @relation("AlertSupersedes", fields: [supersedesId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_alerts_supersedes")
  supersededBy Alert?      @relation("AlertSupersedes")
  wards        AlertWard[]

  @@unique([origin, originRef], map: "uq_alerts_origin_ref")
  @@index([status, validTo], map: "idx_alerts_status_valid_to")
  @@index([publishedAt(sort: Desc)], map: "idx_alerts_published_at")
  @@index([area], map: "idx_alerts_area", type: Gist)
  @@map("alerts")
}

model AlertWard {
  alertId String @map("alert_id") @db.Uuid
  wardId  String @map("ward_id") @db.Uuid

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_alert_wards_alert")
  ward  Ward  @relation(fields: [wardId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_alert_wards_ward")

  @@id([alertId, wardId], map: "pk_alert_wards")
  @@index([wardId], map: "idx_alert_wards_ward")
  @@map("alert_wards")
}

/// Extra wards (scope ward), zones and one `city` row carrying muted_types / critical_only.
/// Owner is a user (signed in) or a device (visitor). Partial unique indexes in the migration.
model Subscription {
  id           String            @id(map: "pk_subscriptions") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?           @map("user_id") @db.Uuid
  deviceId     String?           @map("device_id") @db.Uuid
  scope        SubscriptionScope
  scopeId      String?           @map("scope_id") @db.Uuid
  category     String?
  channel      String            @default("push")
  mutedTypes   AlertType[]       @default([]) @map("muted_types")
  criticalOnly Boolean           @default(false) @map("critical_only")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_subscriptions_user")
  device Device? @relation(fields: [deviceId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_subscriptions_device")

  @@map("subscriptions")
}

/// TASK-12 (REQ-F-057, REQ-D-010): AMC services directory. category/slug/url CHECKs are hand-written in the
/// migration. Production rows come from `npm run services:seed` (prisma/seed-data/services.ts).
model Service {
  id              String    @id(map: "pk_services") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String    @db.VarChar(60)
  category        String    @db.VarChar(20)
  nameEn          String    @map("name_en") @db.VarChar(80)
  nameGu          String    @map("name_gu") @db.VarChar(80)
  department      String    @db.VarChar(100)
  departmentGu    String    @map("department_gu") @db.VarChar(100)
  summaryEn       String    @map("summary_en") @db.VarChar(300)
  summaryGu       String    @map("summary_gu") @db.VarChar(300)
  howToEn         String    @map("how_to_en")
  howToGu         String    @map("how_to_gu")
  url             String    @db.VarChar(500)
  online          Boolean
  visitWardOffice Boolean   @default(false) @map("visit_ward_office")
  sortOrder       Int       @default(100) @map("sort_order")
  isActive        Boolean   @default(true) @map("is_active")
  linkOk          Boolean?  @map("link_ok")
  linkStatusCode  Int?      @map("link_status_code")
  linkError       String?   @map("link_error") @db.VarChar(40)
  lastCheckedAt   DateTime? @map("last_checked_at") @db.Timestamptz(6)
  verifiedAt      DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tips ServiceTip[]

  @@unique([slug], map: "uq_services_slug")
  @@index([category, sortOrder], map: "idx_services_category_sort")
  @@map("services")
}

/// TASK-12 (REQ-F-059): civic drives and events. type/organiser/status/time/capacity/source CHECKs are
/// hand-written in the migration. going_count is maintained inside the RSVP transaction.
model Initiative {
  id             String                                 @id(map: "pk_initiatives") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titleEn        String                                 @map("title_en") @db.VarChar(100)
  titleGu        String                                 @map("title_gu") @db.VarChar(100)
  descriptionEn  String                                 @map("description_en") @db.VarChar(1000)
  descriptionGu  String                                 @map("description_gu") @db.VarChar(1000)
  type           String                                 @db.VarChar(20)
  organiser      String                                 @db.VarChar(20)
  organiserName  String                                 @map("organiser_name") @db.VarChar(100)
  sourceUrl      String?                                @map("source_url") @db.VarChar(500)
  wardId         String?                                @map("ward_id") @db.Uuid
  locationTextEn String                                 @map("location_text_en") @db.VarChar(200)
  locationTextGu String                                 @map("location_text_gu") @db.VarChar(200)
  location       Unsupported("geography(Point, 4326)")?
  lat            Decimal?                               @db.Decimal(9, 6)
  lng            Decimal?                               @db.Decimal(9, 6)
  startsAt       DateTime                               @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime                               @map("ends_at") @db.Timestamptz(6)
  capacity       Int?
  status         String                                 @db.VarChar(20)
  goingCount     Int                                    @default(0) @map("going_count")
  reminderSentAt DateTime?                              @map("reminder_sent_at") @db.Timestamptz(6)
  createdById    String?                                @map("created_by") @db.Uuid
  updatedById    String?                                @map("updated_by") @db.Uuid
  createdAt      DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  ward      Ward?  @relation(fields: [wardId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_initiatives_ward")
  createdBy User?  @relation("InitiativeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_initiatives_created_by")
  updatedBy User?  @relation("InitiativeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_initiatives_updated_by")
  rsvps     Rsvp[]

  @@index([status, startsAt], map: "idx_initiatives_status_starts")
  @@index([wardId, startsAt], map: "idx_initiatives_ward_starts")
  @@map("initiatives")
}

/// TASK-12 (REQ-F-060): one RSVP per user per initiative; status CHECK hand-written.
model Rsvp {
  initiativeId       String   @map("initiative_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  status             String   @db.VarChar(20)
  attendanceMarkedBy String?  @map("attendance_marked_by") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  initiative Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_rsvps_initiative")
  user       User       @relation("RsvpUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_rsvps_user")
  markedBy   User?      @relation("RsvpMarkedBy", fields: [attendanceMarkedBy], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_rsvps_marked_by")

  @@id([initiativeId, userId], map: "pk_rsvps")
  @@index([userId], map: "idx_rsvps_user")
  @@map("rsvps")
}

/// TASK-12 (REQ-F-061, P2): seasonal tips shown on Home; active window CHECK hand-written.
model ServiceTip {
  id          String   @id(map: "pk_service_tips") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titleEn     String   @map("title_en") @db.VarChar(80)
  titleGu     String   @map("title_gu") @db.VarChar(80)
  bodyEn      String   @map("body_en") @db.VarChar(240)
  bodyGu      String   @map("body_gu") @db.VarChar(240)
  serviceId   String?  @map("service_id") @db.Uuid
  wardId      String?  @map("ward_id") @db.Uuid
  activeFrom  DateTime @map("active_from") @db.Date
  activeTo    DateTime @map("active_to") @db.Date
  isActive    Boolean  @default(true) @map("is_active")
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_service_tips_service")
  ward      Ward?    @relation(fields: [wardId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_service_tips_ward")
  createdBy User?    @relation("ServiceTipCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "fk_service_tips_created_by")

  @@index([activeFrom, activeTo], map: "idx_service_tips_window")
  @@map("service_tips")
}

// V2 TASK-06: escalation ladder contacts (zone office, Deputy Municipal Commissioner, Municipal Commissioner).
// ck_escalation_contacts_level and the partial index uq_escalation_contacts_level_citywide are hand-written in
// migration 20261014060000_v2_lifecycle.
model EscalationContact {
  id             String   @id(map: "pk_escalation_contacts") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  level          String   @db.VarChar(30)
  zoneId         String?  @map("zone_id") @db.Uuid
  titleEn        String   @map("title_en") @db.VarChar(160)
  titleGu        String   @map("title_gu") @db.VarChar(200)
  email          String?  @db.VarChar(254)
  phone          String?  @db.VarChar(20)
  sourceUrl      String   @map("source_url") @db.VarChar(500)
  lastVerifiedAt DateTime @map("last_verified_at") @db.Date
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  zone Zone? @relation(fields: [zoneId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_escalation_contacts_zone")

  @@unique([level, zoneId], map: "uq_escalation_contacts_level_zone")
  @@map("escalation_contacts")
}
