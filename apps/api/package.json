{
  "name": "@saarthee/api",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start:prod": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "admin:create": "tsx --env-file=.env scripts/admin-create.ts",
    "photos:cleanup": "tsx --env-file=.env scripts/cleanup-photos.ts",
    "storage:check": "tsx --env-file=.env scripts/check-storage.ts",
    "retention:run": "tsx --env-file=.env scripts/retention.ts",
    "rates:snapshot": "tsx --env-file=.env scripts/rates-snapshot.ts",
    "push:flush": "tsx --env-file=.env scripts/push-flush.ts",
    "push:test": "tsx --env-file=.env scripts/push-test.ts",
    "auth:emulator-check": "tsx --env-file=.env scripts/auth-emulator-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db:create": "bash scripts/test-db-create.sh",
    "db:drift": "bash scripts/check-prisma-drift.sh",
    "db:check-v1": "bash scripts/check-v1-migrations.sh",
    "legacy:migrate": "tsx --env-file=.env scripts/legacy-migrate.ts",
    "geo:convert": "tsx scripts/geo/kml-to-geojson.ts",
    "geo:import": "tsx --env-file=.env scripts/geo/import.ts",
    "geo:crosscheck": "tsx --env-file=.env scripts/geo/crosscheck.ts",
    "geo:backfill": "tsx --env-file=.env scripts/geo/backfill.ts",
    "geo:fixture": "tsx --env-file=.env scripts/geo/fixture.ts",
    "amc:problems:fetch": "tsx --env-file=.env scripts/fetch-amc-problems.ts"
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@prisma/client": "6.19.3",
    "@sentry/node": "11.4.0",
    "argon2": "0.45.1",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "firebase-admin": "13.10.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.4.0",
    "pino": "10.4.0",
    "pino-roll": "4.0.0",
    "prisma": "6.19.3",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "pg": "8.23.1",
    "pino-pretty": "13.1.3",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.11"
  }
}
