# Copy to .env.test (git-ignored) for `npm test`. See test/README.md.
# The test guard refuses any DATABASE_URL whose database name does not end in `_test` or `_test_<suffix>`.
# Every run rebuilds this database from prisma/migrations and gives each test file a private copy.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
DATABASE_URL=postgresql://saarthee:change-me@127.0.0.1:5433/saarthee_test
# Empty, disposable database for the drift gate (scripts/check-prisma-drift.sh).
SHADOW_DATABASE_URL=postgresql://saarthee:change-me@127.0.0.1:5433/saarthee_shadow
JWT_SECRET=test-only-secret-at-least-32-bytes-long-000000
JWT_ISSUER=saarthee-api
JWT_AUDIENCE=saarthee-admin
JWT_EXPIRES_IN=8h
STORAGE_DRIVER=local
# Absolute path OUTSIDE the repository (tests write small generated photos here).
PHOTO_STORAGE_DIR=/tmp/saarthee-test-photos
PHOTO_MAX_UPLOAD_BYTES=5242880
PHOTO_MAX_EDGE_PX=2048
UNATTACHED_PHOTO_TTL_HOURS=24
REMINDER_INTERVAL_DAYS=7
VERIFY_LINK_BASE=saarthee://verify?t=
VERIFY_DISTANCE_WARN_M=
CONSENT_TEXT_VERSIONS=v1
REMINDER_TEMPLATE_VERSION=v1
CORS_ORIGINS=
TRUST_PROXY=false
LOG_LEVEL=warn
LOG_FILE_DIR=
SEED_ADMIN_EMAIL=admin@saarthee.local
SEED_ADMIN_PASSWORD=Test-Admin-Password-1!
# Nearest-ward fallback for /geo/locate outside every ward polygon (metres)
GEO_NEAREST_MAX_M=3000
FIREBASE_AUTH_MODE=fake
PUSH_DRIVER=memory
