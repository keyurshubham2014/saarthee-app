# Copy to .env (git-ignored). Generate secrets with a CSPRNG, e.g. `openssl rand -base64 48`.
APP_ENV=development
# 0.0.0.0 lets the Android emulator (10.0.2.2) and LAN phones reach the API
API_HOST=0.0.0.0
API_PORT=4000
DATABASE_URL=postgresql://saarthee:change-me@127.0.0.1:5433/saarthee
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=saarthee-api
JWT_AUDIENCE=saarthee-admin
JWT_EXPIRES_IN=8h
STORAGE_DRIVER=local
# Absolute path OUTSIDE the repository
PHOTO_STORAGE_DIR=/absolute/path/outside/repo/saarthee-photos
PHOTO_MAX_UPLOAD_BYTES=5242880
PHOTO_MAX_EDGE_PX=2048
UNATTACHED_PHOTO_TTL_HOURS=24
REMINDER_INTERVAL_DAYS=7
VERIFY_LINK_BASE=saarthee://verify?t=
# Empty = distance highlight off
VERIFY_DISTANCE_WARN_M=
CONSENT_TEXT_VERSIONS=v1
REMINDER_TEMPLATE_VERSION=v1
CORS_ORIGINS=
TRUST_PROXY=false
LOG_LEVEL=debug
# Optional file log with daily rotation (<= 14 days). Empty = stdout only.
LOG_FILE_DIR=
# --- V2 TASK-13 (all optional locally; full reference: docs/ops/environments.md) ---
# local | staging | pilot (labels error reports; enables the staging-only /admin/__test-error hook)
DEPLOY_ENV=local
# Required only when STORAGE_DRIVER=cloudflare_r2 (R2_ENDPOINT overrides the R2 URL, e.g. MinIO in tests)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
# Error alerting; empty = off. Events are scrubbed of PII before sending.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
RETENTION_CLOSED_PHOTO_DAYS=730
RETENTION_NOTIFICATION_DAYS=90
RETENTION_LOG_DAYS=14
REOPEN_WINDOW_DAYS=7
# Used only by seed / admin:create. Remove from .env after seeding.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Nearest-ward fallback for /geo/locate outside every ward polygon (metres)
GEO_NEAREST_MAX_M=3000

# v2 TASK-04 citizen accounts + push (docs/v2/firebase-setup.md). Defaults shown.
# google = real Firebase (needs GOOGLE_APPLICATION_CREDENTIALS); emulator = Firebase Auth Emulator; fake = tests.
FIREBASE_AUTH_MODE=emulator
FIREBASE_PROJECT_ID=demo-saarthee
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Absolute path to the service-account JSON (outside git). Required for google / fcm.
GOOGLE_APPLICATION_CREDENTIALS=
USER_JWT_AUDIENCE=saarthee-app
USER_JWT_EXPIRES_IN=30d
# fcm | log (local default, sends nothing) | memory (tests)
PUSH_DRIVER=log
CONSENT_TEXT_VERSIONS_V2=v2-1
GRIEVANCE_EMAIL=privacy@saarthee.in

# TASK-09 representatives relay and scorecard. EMAIL_DRIVER: file (local .eml files) | ses (Amazon SES v2).
EMAIL_DRIVER=file
EMAIL_FILE_DIR=
SES_REGION=ap-south-1
SES_FROM=relay@saarthee.in
EMAIL_OPS_ADDRESS=ops@saarthee.in
PUBLIC_WEB_BASE_URL=https://saarthee.in
RELAY_PER_REP_DAILY=5
RELAY_PER_USER_DAILY=20
SCORECARD_MIN_SAMPLE=5
# Shared job runner (src/jobs): true starts the in-process scheduler in server.ts; npm run jobs:run -- <name> runs one job now.
JOBS_ENABLED=false
# TASK-08 civic alerts. SACHET/IMD only create drafts; nothing is published automatically.
ALERT_MAX_VALIDITY_DAYS=14
QUIET_HOURS=22:00-07:00
APP_TIMEZONE=Asia/Kolkata
SACHET_ENABLED=false
# The CapFeed page is HTML; the RSS of CAP files for Gujarat is:
SACHET_FEED_URL=https://sachet.ndma.gov.in/cap_public_website/rss/rss_gujarat.xml
SACHET_POLL_MINUTES=10
IMD_ENABLED=false
IMD_DISTRICT_WARNINGS_URL=
# TASK-11 representative claims, ward dashboard and reply-by-email tracking.
REP_CLAIM_MAX_PER_DAY=3
REP_EXPORT_MAX_PER_HOUR=10
# HMAC secret for POST /webhooks/mail-inbound (empty = webhook disabled, 401).
MAIL_INBOUND_SECRET=
MAIL_REPLY_DOMAIN=reply.saarthee.local
REP_DASHBOARD_HOTSPOT_CELL_M=150
