# Template for /etc/saarthee/api.env on a staging/pilot host (mode 600, owner root). NO real values in git.
# Every variable is described in docs/ops/environments.md (purpose, example, secret flag, where stored).
APP_ENV=production
# staging | pilot
DEPLOY_ENV=staging
API_HOST=0.0.0.0
API_PORT=3000
# Managed PostgreSQL 17 + PostGIS; TLS required. SECRET.
DATABASE_URL=postgresql://saarthee_app:<password>@<host>:25060/saarthee?sslmode=require
# SECRET — openssl rand -base64 48
JWT_SECRET=<random-48-bytes-base64>
JWT_ISSUER=saarthee-api
JWT_AUDIENCE=saarthee-admin
JWT_EXPIRES_IN=8h
# Photos in Cloudflare R2 (private bucket, scoped token: Object Read & Write on this bucket only).
STORAGE_DRIVER=cloudflare_r2
R2_ACCOUNT_ID=<cloudflare-account-id>
# SECRET (R2 token access key id)
R2_ACCESS_KEY_ID=<r2-access-key-id>
# SECRET (R2 token secret)
R2_SECRET_ACCESS_KEY=<r2-secret>
R2_BUCKET=saarthee-staging-photos
PHOTO_STORAGE_DIR=
PHOTO_MAX_UPLOAD_BYTES=5242880
PHOTO_MAX_EDGE_PX=2048
UNATTACHED_PHOTO_TTL_HOURS=24
REMINDER_INTERVAL_DAYS=7
VERIFY_LINK_BASE=saarthee://verify?t=
VERIFY_DISTANCE_WARN_M=
CONSENT_TEXT_VERSIONS=v1
REMINDER_TEMPLATE_VERSION=v1
CORS_ORIGINS=
TRUST_PROXY=true
LOG_LEVEL=info
LOG_FILE_DIR=/data/logs
# Error alerting (optional; events are scrubbed before sending). SECRET-ish (DSN allows event submission).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
RETENTION_CLOSED_PHOTO_DAYS=730
RETENTION_NOTIFICATION_DAYS=90
RETENTION_LOG_DAYS=14
REOPEN_WINDOW_DAYS=7
