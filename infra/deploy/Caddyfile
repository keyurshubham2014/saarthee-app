# Staging / pilot origin (V2 TASK-13 step 7). Cloudflare (proxied, SSL Full (strict), Always Use HTTPS,
# HSTS) sits in front; this origin presents a Cloudflare Origin CA certificate and accepts 443 only from
# Cloudflare IP ranges (DigitalOcean cloud firewall). SITE_ADDRESS is api.<domain> or api-staging.<domain>.
{
	admin off
	servers {
		# Only Cloudflare may set the client IP header. Ranges: https://www.cloudflare.com/ips/
		# (re-check quarterly; listed in docs/ops/environments.md).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
		protocols h1 h2
	}
}

import /etc/caddy/snippets/api.caddy

{$SITE_ADDRESS} {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	import saarthee_api
}
