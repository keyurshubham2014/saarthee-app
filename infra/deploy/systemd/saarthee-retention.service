# retention job (V2 TASK-13; docs/ops/deploy.md §Timers). Installed by install-host.sh.
[Unit]
Description=Saarthee retention job
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/saarthee
EnvironmentFile=-/etc/saarthee/backup.env
ExecStart=/opt/saarthee/retention.sh
TimeoutStartSec=1h
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
